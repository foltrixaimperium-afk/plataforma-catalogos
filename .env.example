# Copiá este archivo como .env y pegá tus dos datos de Supabase.
# (Estos dos valores son públicos por diseño: la base está protegida por sus propias reglas.)

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# La dirección del sitio NO se pone acá.
# En tu computadora se detecta sola (localhost).
# En producción sale de netlify.toml.
